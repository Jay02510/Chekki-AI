# Loaded by `vite --mode smoke` (npm run test:smoke). Same isolation as
# .env.e2e (emulators, demo project, no service account) except Gemini is
# REAL: API_KEY comes from your .env. Each run costs a few cents.
VITE_USE_EMULATORS=true
VITE_ENABLE_ANALYTICS=false
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
GOOGLE_CLOUD_PROJECT=demo-chekki
GCLOUD_PROJECT=demo-chekki
FIREBASE_SERVICE_ACCOUNT=
MOCK_GEMINI=false
ADMIN_PASSCODE=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
KV_REST_API_URL=
KV_REST_API_TOKEN=
