# Loaded by `vite --mode e2e` (npm run test:e2e). Overrides .env so an
# end-to-end run can never reach production Firebase or real Gemini.
VITE_USE_EMULATORS=true
VITE_ENABLE_ANALYTICS=false
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
GOOGLE_CLOUD_PROJECT=demo-chekki
GCLOUD_PROJECT=demo-chekki
FIREBASE_SERVICE_ACCOUNT=
API_KEY=
MOCK_GEMINI=true
ADMIN_PASSCODE=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
KV_REST_API_URL=
KV_REST_API_TOKEN=
