
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is an admin
    function isAdmin() {
      return exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Helper: Check if user belongs to a school
    function userBelongsToSchool(schoolId) {
      return request.auth != null && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.schoolId == schoolId;
    }

    // Helper: Check if parent belongs to a class
    function userBelongsToClass(classId) {
      return request.auth != null && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.classId == classId;
    }

    // Helper: Check if user is a designated teacher of a class — either the
    // original single-owner `teacherUid` (pre-multi-teacher classes) or
    // listed in `assignedTeacherUids` (director-assigned co-teachers, e.g.
    // FT+KT sharing a class). Checking both keeps every class doc written
    // before this field existed working exactly as before.
    function isClassTeacher(classId) {
      let classData = get(/databases/$(database)/documents/classes/$(classId)).data;
      // Also requires the caller to still BE an active teacher, not just
      // once-matched a class doc's teacherUid — otherwise a director
      // removing a teacher (api/remove-teacher.ts clears their role/schoolId)
      // wouldn't actually revoke access to classes that teacher originally
      // created, since teacherUid alone never expires.
      return request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'teacher' && (
          classData.teacherUid == request.auth.uid ||
          ('assignedTeacherUids' in classData && classData.assignedTeacherUids.hasAny([request.auth.uid]))
        );
    }

    // Helper: Check if user is a director of the school that owns a class.
    // Directors aren't the class's teacherUid (that's the FT/KT who created
    // it), so isClassTeacher() alone always excludes them — this is why
    // roster actions (approve/decline/remove/move/flag) written as
    // `role == 'teacher' && isClassTeacher(classId)` silently failed for
    // directors even after NativeDirectorPortal started using the real
    // roster component.
    function isSchoolDirectorOfClass(classId) {
      return request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'director' &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.schoolId ==
          get(/databases/$(database)/documents/classes/$(classId)).data.schoolId;
    }

    // User Profiles: Authenticated users can read profiles; updates restricted to self or admin
    match /users/{userId} {
      allow read: if request.auth != null;

      allow create: if request.auth != null && (
        isAdmin() || 
        (request.auth.uid == userId && 
         request.resource.data.plan == 'free' && 
         request.resource.data.maxScansPerDay == 2 && 
         request.resource.data.maxQuestionsPerDay == 5)
      );
      allow delete: if request.auth != null && (request.auth.uid == userId || isAdmin());
      
      allow update: if request.auth != null && (
        isAdmin() || 
        // User updating their own profile
        (request.auth.uid == userId && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'plan', 'schoolId', 'schoolName', 'educatorRole', 'scansUsedToday', 'maxScansPerDay', 'questionsUsedToday', 'maxQuestionsPerDay', 'generatesUsedToday', 'maxGeneratesPerDay', 'lastScanDate', 'lastQuestionDate', 'lastGenerateDate'])) ||
        // Teacher or director updating classroom fields (roster
        // approve/decline/remove/move, flaggedException) on a student in
        // their own class/school.
        (
          (
            (request.resource.data.classId != null && (isClassTeacher(request.resource.data.classId) || isSchoolDirectorOfClass(request.resource.data.classId))) ||
            (resource.data.classId != null && (isClassTeacher(resource.data.classId) || isSchoolDirectorOfClass(resource.data.classId)) && request.resource.data.classId == null)
          ) &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'plan', 'email', 'name', 'schoolId', 'schoolName', 'childAge', 'childEnglishLevel', 'parentEnglishLevel'])
        )
      );
    }

    match /users/{userId}/data/{document=**} {
      allow read: if request.auth != null && (
        request.auth.uid == userId || 
        isAdmin() ||
        (
          get(/databases/$(database)/documents/users/$(userId)).data.classId != null &&
          isClassTeacher(get(/databases/$(database)/documents/users/$(userId)).data.classId)
        )
      );
      allow write: if request.auth != null && (request.auth.uid == userId || isAdmin());
    }
    
    // Helper to prevent storage exhaustion and ensure type safety
    function isValidMistake() {
      let data = request.resource.data;
      let qValid = !data.keys().hasAny(['question_text']) || (data.question_text is string && data.question_text.size() < 1000);
      let aValid = !data.keys().hasAny(['correct_answer']) || (data.correct_answer is string && data.correct_answer.size() < 1000);
      return qValid && aValid;
    }

    // Helper to validate curriculum pre-seeding documents including the 'other' field
    function isValidCurriculum() {
      let data = request.resource.data;
      let topicValid = !data.keys().hasAny(['topic']) || (data.topic is string && data.topic.size() <= 2000);
      let passageValid = !data.keys().hasAny(['passage']) || (data.passage is string && data.passage.size() <= 10000);
      let otherValid = !data.keys().hasAny(['other']) || (data.other is string && data.other.size() <= 10000);
      return topicValid && passageValid && otherValid;
    }

    // Mistakes: Strict ownership check & authorized teacher analytics access.
    match /mistakes/{mistakeId} {
      allow get, list: if request.auth != null && (
        (resource.data.userId == request.auth.uid) || 
        isAdmin() ||
        (
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'teacher' &&
          isClassTeacher(get(/databases/$(database)/documents/users/$(resource.data.userId)).data.classId)
        )
      );
      
      allow create: if request.auth != null 
        && request.resource.data.userId == request.auth.uid
        && isValidMistake();
        
      allow update: if request.auth != null && (
        isAdmin() ||
        (resource.data.userId == request.auth.uid 
         && request.resource.data.userId == request.auth.uid 
         && isValidMistake())
      );
      
      allow delete: if request.auth != null && (
        (resource.data.userId == request.auth.uid) || isAdmin()
      );
    }

    
    function isValidFeedback() {
      let data = request.resource.data;
      let cValid = !data.keys().hasAny(['comment']) || (data.comment is string && data.comment.size() < 2000);
      let rValid = !data.keys().hasAny(['rating']) || (data.rating is number);
      let uValid = !data.keys().hasAny(['userEmail']) || (data.userEmail is string && data.userEmail.size() < 100);
      return cValid && rValid && uValid;
    }

    // Feedback: Authenticated users can create, only admins can read.
    match /feedback/{feedbackId} {
      allow create: if request.auth != null && isValidFeedback();
      allow read: if request.auth != null && isAdmin();
    }

    // System: Only admins can write system-wide configs.
    match /system/{docId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && isAdmin();
    }
    
    // Subscriptions: Users can only read their own, backend (Admin SDK) handles writes
    match /subscriptions/{userId} {
      allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
      allow write: if isAdmin();
    }

    // Admins collection: Private.
    match /admins/{adminId} {
      allow read: if request.auth != null && request.auth.uid == adminId;
      allow write: if false; // Only manageable via Firebase Console
    }

    // Rate Limits: Only writable by the backend Admin SDK (service account).
    // Client-side access is explicitly denied. The Admin SDK bypasses these rules entirely.
    match /ratelimits/{docId} {
      allow read, write: if false;
    }

    // Quiz Quotas: Tracked server-side only. No client read/write.
    match /quiz_quotas/{docId} {
      allow read, write: if false;
    }

    // Idempotency Keys: Used for deduplication server-side only.
    match /idempotency_keys/{docId} {
      allow read, write: if false;
    }

    // School Invoices: Managed exclusively via backend Admin SDK (Vercel Serverless).
    match /school_invoices/{docId} {
      allow read, write: if false;
    }

    // Schools rules
    match /schools/{schoolId} {
      allow read: if request.auth != null && (
        isAdmin() ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.schoolId == schoolId
      );
      allow write: if request.auth != null && isAdmin();
    }

    // Teacher invites (audit §21): director dashboards read these directly via
    // the client SDK to show seat usage and pending invites, but every write
    // (create on send, claim on redemption) only ever happens server-side via
    // Admin SDK in api/create-teacher-invite.ts and api/redeem-invite.ts —
    // role and seat-limit enforcement live there, not in these rules.
    match /invites/{inviteId} {
      allow read: if request.auth != null && (
        isAdmin() ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.schoolId == resource.data.schoolId
      );
      allow write: if false;
    }

    // Classes rules
    match /classes/{classId} {
      allow read: if request.auth != null;
      // Creation only happens server-side via api/create-class.ts (Admin SDK,
      // bypasses these rules), which counts existing classes against
      // schools/{schoolId}.seatsTotal before writing. A client-side
      // `teacherUid == request.auth.uid` create rule (the old version of this
      // rule) had no count check at all — any authenticated teacher could
      // create unlimited classes on a 1-seat plan (audit §2/§10/§18).
      allow create: if request.auth != null && isAdmin();
      // Co-teacher assignment (assignedTeacherUids) only ever happens
      // server-side via api/assign-class-teacher.ts (Admin SDK) — director-
      // authorized and school-membership-checked there. This rule only
      // covers day-to-day field updates (e.g. activeWeekNumber) by whoever
      // is already an owner or assigned teacher, not who can become one.
      allow update: if request.auth != null && (
        (
          (resource.data.teacherUid == request.auth.uid ||
            ('assignedTeacherUids' in resource.data && resource.data.assignedTeacherUids.hasAny([request.auth.uid]))) &&
          request.resource.data.teacherUid == resource.data.teacherUid &&
          request.resource.data.assignedTeacherUids == resource.data.assignedTeacherUids
        ) ||
        isAdmin()
      );
      allow delete: if request.auth != null && (
        resource.data.teacherUid == request.auth.uid ||
        isAdmin()
      );

      // Class logs (FT/KT daily log entries). Readable by the teacher(s) and
      // director who own the class, plus parents whose enrolled child belongs
      // to this class — closes the loop between what a teacher records and
      // what the parent sees. Written only by the class's own teacher(s).
      match /logs/{logId} {
        allow read: if request.auth != null && (
          userBelongsToClass(classId) ||
          isClassTeacher(classId) ||
          isSchoolDirectorOfClass(classId) ||
          isAdmin()
        );
        allow create: if request.auth != null && (
          isClassTeacher(classId) ||
          isAdmin()
        ) && request.resource.data.classId == classId;
        // The only legitimate update is a KT (or co-teacher) reviewing and
        // sending the log — writing the approved parent-facing text back
        // onto the same doc. Restricted to just those fields so a teacher
        // can't rewrite another teacher's original raw log after the fact.
        allow update: if request.auth != null && (
          isAdmin() ||
          (
            isClassTeacher(classId) &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(
              ['approvedSummary', 'approvedExceptions', 'reviewStatus', 'reviewedByUid', 'sentAt']
            )
          )
        );
        allow delete: if request.auth != null && isAdmin();
      }

      match /studentScans/{scanId} {
        allow read: if request.auth != null;
        // A scan can only ever be written as the writer's own uid — the old
        // rule OR'd `userBelongsToClass(classId)` on its own, which let any
        // classmate create/overwrite another student's scan record, and
        // OR'd the studentUid-match on its own, which let anyone write into
        // a class they don't belong to as long as they set studentUid to
        // themselves. Both conditions are now required together.
        allow create, update: if request.auth != null && (
          (userBelongsToClass(classId) && request.resource.data.studentUid == request.auth.uid) ||
          isClassTeacher(classId) ||
          isAdmin()
        );
        allow delete: if request.auth != null && (
          isClassTeacher(classId) ||
          resource.data.studentUid == request.auth.uid ||
          isAdmin()
        );
      }
    }

    // Curriculum pre-seeding rules
    match /curriculums/{curriculumId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && (
        isClassTeacher(request.resource.data.classId) ||
        (request.resource.data.teacherUid != null && request.resource.data.teacherUid == request.auth.uid) ||
        isAdmin()
      ) && isValidCurriculum();
      allow update: if request.auth != null && (
        (isClassTeacher(resource.data.classId) && isClassTeacher(request.resource.data.classId)) ||
        (resource.data.teacherUid == request.auth.uid && request.resource.data.teacherUid == request.auth.uid) ||
        isAdmin()
      ) && isValidCurriculum();
      allow delete: if request.auth != null && (
        isClassTeacher(resource.data.classId) ||
        (resource.data.teacherUid != null && resource.data.teacherUid == request.auth.uid) ||
        isAdmin()
      );
    }
  }
}
