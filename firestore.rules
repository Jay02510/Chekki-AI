
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is an admin
    function isAdmin() {
      return exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // User Profiles: Users can only read/write their own profile
    match /users/{userId} {
      allow read, write: if request.auth != null && (request.auth.uid == userId || isAdmin());
    }
    
    // Mistakes: Strict ownership check. No one can list all mistakes.
    match /mistakes/{mistakeId} {
      allow read, write: if request.auth != null && (
        (request.resource.data.userId == request.auth.uid) ||
        (resource.data.userId == request.auth.uid) ||
        isAdmin()
      );
    }

    // Feedback: Authenticated users can create, only admins can read.
    match /feedback/{feedbackId} {
      allow create: if request.auth != null;
      allow read: if request.auth != null && isAdmin();
    }

    // System: Only admins can write system-wide configs.
    match /system/{docId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && isAdmin();
    }
    
    // Admins collection: Private.
    match /admins/{adminId} {
      allow read: if request.auth != null && request.auth.uid == adminId;
      allow write: if false; // Only manageable via Firebase Console
    }
  }
}
