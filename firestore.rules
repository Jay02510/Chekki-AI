
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is an admin
    function isAdmin() {
      return exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Helper: Check if user belongs to a school
    function userBelongsToSchool(schoolId) {
      return request.auth != null && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.schoolId == schoolId;
    }

    // Helper: Check if parent belongs to a class
    function userBelongsToClass(classId) {
      return request.auth != null && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.classId == classId;
    }

    // Helper: Check if user is the designated teacher of a class
    function isClassTeacher(classId) {
      return request.auth != null && 
        get(/databases/$(database)/documents/classes/$(classId)).data.teacherUid == request.auth.uid;
    }

    // User Profiles: Users can only read/write their own profile, except teachers who manage classes
    match /users/{userId} {
      allow get: if request.auth != null && (
        request.auth.uid == userId || 
        isAdmin() ||
        (resource.data.classId != null && isClassTeacher(resource.data.classId)) ||
        (resource.data.schoolId != null && request.auth.uid != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.schoolId == resource.data.schoolId)
      );
      
      allow list: if request.auth != null && (
        isAdmin() ||
        (
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'teacher' &&
          isClassTeacher(resource.data.classId)
        )
      );

      allow create: if request.auth != null && (
        isAdmin() || 
        (request.auth.uid == userId && 
         request.resource.data.plan == 'free' && 
         request.resource.data.maxScansPerDay == 2 && 
         request.resource.data.maxQuestionsPerDay == 5)
      );
      allow delete: if request.auth != null && (request.auth.uid == userId || isAdmin());
      
      allow update: if request.auth != null && (
        isAdmin() || 
        // User updating their own profile
        (request.auth.uid == userId && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'plan', 'scansUsedToday', 'maxScansPerDay', 'questionsUsedToday', 'maxQuestionsPerDay', 'generatesUsedToday', 'maxGeneratesPerDay', 'lastScanDate', 'lastQuestionDate', 'lastGenerateDate'])) ||
        // Teacher updating classroom fields
        (
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'teacher' &&
          (
            (request.resource.data.classId != null && isClassTeacher(request.resource.data.classId)) ||
            (resource.data.classId != null && isClassTeacher(resource.data.classId) && request.resource.data.classId == null)
          ) &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'plan', 'email', 'name', 'schoolId', 'schoolName', 'childAge', 'childEnglishLevel', 'parentEnglishLevel'])
        )
      );
    }

    match /users/{userId}/data/{document=**} {
      allow read: if request.auth != null && (
        request.auth.uid == userId || 
        isAdmin() ||
        (
          get(/databases/$(database)/documents/users/$(userId)).data.classId != null &&
          isClassTeacher(get(/databases/$(database)/documents/users/$(userId)).data.classId)
        )
      );
      allow write: if request.auth != null && (request.auth.uid == userId || isAdmin());
    }
    
    // Helper to prevent storage exhaustion and ensure type safety
    function isValidMistake() {
      let data = request.resource.data;
      let qValid = !data.keys().hasAny(['question_text']) || (data.question_text is string && data.question_text.size() < 1000);
      let aValid = !data.keys().hasAny(['correct_answer']) || (data.correct_answer is string && data.correct_answer.size() < 1000);
      return qValid && aValid;
    }

    // Mistakes: Strict ownership check & authorized teacher analytics access.
    match /mistakes/{mistakeId} {
      allow get, list: if request.auth != null && (
        (resource.data.userId == request.auth.uid) || 
        isAdmin() ||
        (
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'teacher' &&
          isClassTeacher(get(/databases/$(database)/documents/users/$(resource.data.userId)).data.classId)
        )
      );
      
      allow create: if request.auth != null 
        && request.resource.data.userId == request.auth.uid
        && isValidMistake();
        
      allow update: if request.auth != null && (
        isAdmin() ||
        (resource.data.userId == request.auth.uid 
         && request.resource.data.userId == request.auth.uid 
         && isValidMistake())
      );
      
      allow delete: if request.auth != null && (
        (resource.data.userId == request.auth.uid) || isAdmin()
      );
    }

    
    function isValidFeedback() {
      let data = request.resource.data;
      let cValid = !data.keys().hasAny(['comment']) || (data.comment is string && data.comment.size() < 2000);
      let rValid = !data.keys().hasAny(['rating']) || (data.rating is number);
      let uValid = !data.keys().hasAny(['userEmail']) || (data.userEmail is string && data.userEmail.size() < 100);
      return cValid && rValid && uValid;
    }

    // Feedback: Authenticated users can create, only admins can read.
    match /feedback/{feedbackId} {
      allow create: if request.auth != null && isValidFeedback();
      allow read: if request.auth != null && isAdmin();
    }

    // System: Only admins can write system-wide configs.
    match /system/{docId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && isAdmin();
    }
    
    // Subscriptions: Users can only read their own, backend (Admin SDK) handles writes
    match /subscriptions/{userId} {
      allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
      allow write: if isAdmin();
    }

    // Admins collection: Private.
    match /admins/{adminId} {
      allow read: if request.auth != null && request.auth.uid == adminId;
      allow write: if false; // Only manageable via Firebase Console
    }

    // Rate Limits: Only writable by the backend Admin SDK (service account).
    // Client-side access is explicitly denied. The Admin SDK bypasses these rules entirely.
    match /ratelimits/{docId} {
      allow read, write: if false;
    }

    // Quiz Quotas: Tracked server-side only. No client read/write.
    match /quiz_quotas/{docId} {
      allow read, write: if false;
    }

    // Idempotency Keys: Used for deduplication server-side only.
    match /idempotency_keys/{docId} {
      allow read, write: if false;
    }

    // School Invoices: Managed exclusively via backend Admin SDK (Vercel Serverless).
    match /school_invoices/{docId} {
      allow read, write: if false;
    }

    // Schools rules
    match /schools/{schoolId} {
      allow read: if request.auth != null && (
        isAdmin() ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.schoolId == schoolId
      );
      allow write: if request.auth != null && isAdmin();
    }

    // Classes rules
    match /classes/{classId} {
      allow read: if request.auth != null && (
        resource.data.teacherUid == request.auth.uid ||
        userBelongsToClass(classId) ||
        isAdmin()
      );
      allow create: if request.auth != null && (
        request.resource.data.teacherUid == request.auth.uid ||
        isAdmin()
      );
      allow update: if request.auth != null && (
        (resource.data.teacherUid == request.auth.uid && request.resource.data.teacherUid == request.auth.uid) ||
        isAdmin()
      );
      allow delete: if request.auth != null && (
        resource.data.teacherUid == request.auth.uid ||
        isAdmin()
      );
    }

    // Curriculum pre-seeding rules
    match /curriculums/{curriculumId} {
      allow read: if request.auth != null && (
        userBelongsToClass(resource.data.classId) ||
        isClassTeacher(resource.data.classId) ||
        isAdmin()
      );
      allow create: if request.auth != null && (
        isClassTeacher(request.resource.data.classId) ||
        isAdmin()
      );
      allow update: if request.auth != null && (
        (isClassTeacher(resource.data.classId) && isClassTeacher(request.resource.data.classId)) ||
        isAdmin()
      );
      allow delete: if request.auth != null && (
        isClassTeacher(resource.data.classId) ||
        isAdmin()
      );
    }
  }
}
