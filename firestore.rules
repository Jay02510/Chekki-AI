
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is an admin
    function isAdmin() {
      return exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // User Profiles: Users can only read/write their own profile
    match /users/{userId} {
      allow get: if request.auth != null && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();
      allow create: if request.auth != null && (
        isAdmin() || 
        (request.auth.uid == userId && 
         request.resource.data.plan == 'free' && 
         request.resource.data.maxScansPerDay == 3 && 
         request.resource.data.maxQuestionsPerDay == 5)
      );
      allow delete: if request.auth != null && (request.auth.uid == userId || isAdmin());
      allow update: if request.auth != null && (
        isAdmin() || 
        (request.auth.uid == userId && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['plan', 'scansUsedToday', 'maxScansPerDay', 'questionsUsedToday', 'maxQuestionsPerDay', 'generatesUsedToday', 'maxGeneratesPerDay', 'lastScanDate', 'lastQuestionDate', 'lastGenerateDate']))
      );
    }
    
    // Helper to prevent storage exhaustion and ensure type safety
    function isValidMistake() {
      let data = request.resource.data;
      let qValid = !data.keys().hasAny(['question_text']) || (data.question_text is string && data.question_text.size() < 1000);
      let aValid = !data.keys().hasAny(['correct_answer']) || (data.correct_answer is string && data.correct_answer.size() < 1000);
      return qValid && aValid;
    }

    // Mistakes: Strict ownership check.
    match /mistakes/{mistakeId} {
      allow get, list: if request.auth != null && (
        (resource.data.userId == request.auth.uid) || isAdmin()
      );
      
      allow create: if request.auth != null 
        && request.resource.data.userId == request.auth.uid
        && isValidMistake();
        
      allow update: if request.auth != null && (
        isAdmin() ||
        (resource.data.userId == request.auth.uid 
         && request.resource.data.userId == request.auth.uid 
         && isValidMistake())
      );
      
      allow delete: if request.auth != null && (
        (resource.data.userId == request.auth.uid) || isAdmin()
      );
    }

    // Feedback: Authenticated users can create, only admins can read.
    match /feedback/{feedbackId} {
      allow create: if request.auth != null;
      allow read: if request.auth != null && isAdmin();
    }

    // System: Only admins can write system-wide configs.
    match /system/{docId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && isAdmin();
    }
    
    // Subscriptions: Users can only read their own, backend (Admin SDK) handles writes
    match /subscriptions/{userId} {
      allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
      allow write: if isAdmin();
    }

    // Admins collection: Private.
    match /admins/{adminId} {
      allow read: if request.auth != null && request.auth.uid == adminId;
      allow write: if false; // Only manageable via Firebase Console
    }

    // Rate Limits: Only writable by the backend Admin SDK (service account).
    // Client-side access is explicitly denied. The Admin SDK bypasses these rules entirely.
    match /ratelimits/{docId} {
      allow read, write: if false;
    }

    // Quiz Quotas: Tracked server-side only. No client read/write.
    match /quiz_quotas/{docId} {
      allow read, write: if false;
    }

    // Idempotency Keys: Used for deduplication server-side only.
    match /idempotency_keys/{docId} {
      allow read, write: if false;
    }
  }
}
