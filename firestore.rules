
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is an admin
    function isAdmin() {
      return exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Helper: Check if user belongs to a school
    function userBelongsToSchool(schoolId) {
      return request.auth != null && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.schoolId == schoolId;
    }

    // Helper: Check if parent belongs to a class
    function userBelongsToClass(classId) {
      return request.auth != null && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.classId == classId;
    }

    // Helper: Check if user is a designated teacher of a class — either the
    // original single-owner `teacherUid` (pre-multi-teacher classes) or
    // listed in `assignedTeacherUids` (director-assigned co-teachers, e.g.
    // FT+KT sharing a class). Checking both keeps every class doc written
    // before this field existed working exactly as before.
    function isClassTeacher(classId) {
      // A demo/sandbox classId (client-only, e.g. `demo_${uid}`, used by the
      // zero-setup preview dashboard) or a brand-new real class's very first
      // read never has a `classes/{classId}` doc yet — dereferencing
      // `get(...).data` on a nonexistent doc errors the rule itself, which
      // Firestore reports as PERMISSION_DENIED instead of a clean "not
      // found" (audit: preview/first-write Firestore reads/writes broken).
      // Guarding with exists() first makes a missing class doc resolve to
      // "not the teacher" instead of crashing the whole rule evaluation.
      return request.auth != null &&
        exists(/databases/$(database)/documents/classes/$(classId)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'teacher' && (
          get(/databases/$(database)/documents/classes/$(classId)).data.teacherUid == request.auth.uid ||
          (
            'assignedTeacherUids' in get(/databases/$(database)/documents/classes/$(classId)).data &&
            get(/databases/$(database)/documents/classes/$(classId)).data.assignedTeacherUids.hasAny([request.auth.uid])
          )
        );
    }

    // Helper: Check if user is a director of the school that owns a class.
    // Directors aren't the class's teacherUid (that's the FT/KT who created
    // it), so isClassTeacher() alone always excludes them — this is why
    // roster actions (approve/decline/remove/move/flag) written as
    // `role == 'teacher' && isClassTeacher(classId)` silently failed for
    // directors even after NativeDirectorPortal started using the real
    // roster component.
    function isSchoolDirectorOfClass(classId) {
      // Same nonexistent-class-doc guard as isClassTeacher() above.
      return request.auth != null &&
        exists(/databases/$(database)/documents/classes/$(classId)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'director' &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.schoolId ==
          get(/databases/$(database)/documents/classes/$(classId)).data.schoolId;
    }

    // User Profiles: read scoped to self, admin, same-school staff roster
    // (TeacherRosterPanel.tsx), or a student's own class roster entry (FT/KT/
    // director fetching enrolled students for a class they teach/administer,
    // TeacherPage.tsx/NativeDirectorPortal.tsx). Previously any signed-in
    // account could read every user's profile — full PII (email, child data,
    // school info, usage counters) for every parent/teacher/director in the
    // app (Audit: unscoped users read, contradicted the published security
    // factsheet's per-school isolation claims).
    match /users/{userId} {
      allow read: if request.auth != null && (
        request.auth.uid == userId ||
        isAdmin() ||
        (
          resource.data.schoolId != null &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'director' &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.schoolId == resource.data.schoolId
        ) ||
        (
          resource.data.classId != null &&
          (isClassTeacher(resource.data.classId) || isSchoolDirectorOfClass(resource.data.classId))
        )
      );

      allow create: if request.auth != null && (
        isAdmin() || 
        (request.auth.uid == userId && 
         request.resource.data.plan == 'free' && 
         request.resource.data.maxScansPerDay == 2 && 
         request.resource.data.maxQuestionsPerDay == 5)
      );
      allow delete: if request.auth != null && (request.auth.uid == userId || isAdmin());
      
      allow update: if request.auth != null && (
        isAdmin() || 
        // User updating their own profile
        (request.auth.uid == userId && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'plan', 'schoolId', 'schoolName', 'educatorRole', 'scansUsedToday', 'maxScansPerDay', 'questionsUsedToday', 'maxQuestionsPerDay', 'generatesUsedToday', 'maxGeneratesPerDay', 'lastScanDate', 'lastQuestionDate', 'lastGenerateDate'])) ||
        // Teacher or director updating classroom fields (roster
        // approve/decline/remove/move, flaggedException) on a student in
        // their own class/school. Allowlisted (hasOnly) rather than
        // blocklisted — the blocklist only excluded a few PII/plan fields,
        // so a valid teacher/director auth token could otherwise write
        // ANY other field on a supervised student's doc via the raw
        // Firestore SDK, including quota fields (maxScansPerDay etc.) the
        // app's own client code never touches through this path (audit:
        // roster-update rule allowed unbounded field writes).
        (
          (
            (request.resource.data.classId != null && (isClassTeacher(request.resource.data.classId) || isSchoolDirectorOfClass(request.resource.data.classId))) ||
            (resource.data.classId != null && (isClassTeacher(resource.data.classId) || isSchoolDirectorOfClass(resource.data.classId)) && request.resource.data.classId == null)
          ) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['classId', 'classStatus', 'flaggedException'])
        )
      );
    }

    match /users/{userId}/data/{document=**} {
      allow read: if request.auth != null && (
        request.auth.uid == userId ||
        isAdmin() ||
        (
          // Prefer the classId stamped on the record itself (set at save time
          // in services/database.ts) over the student's current, live profile
          // classId. The live field used to be the only check, which meant a
          // student switching classes/academies instantly granted the NEW
          // teacher read access to their ENTIRE prior mistake history, and
          // instantly cut off the old teacher — a data-boundary bug, not
          // intended behavior (Audit: class-switch data boundary). Records
          // written before this fix have no classId field, so they fall back
          // to the old live-lookup behavior rather than becoming unreadable.
          resource.data.classId != null
            ? isClassTeacher(resource.data.classId)
            : (
                get(/databases/$(database)/documents/users/$(userId)).data.classId != null &&
                isClassTeacher(get(/databases/$(database)/documents/users/$(userId)).data.classId)
              )
        )
      );
      allow write: if request.auth != null && (request.auth.uid == userId || isAdmin());
    }

    // Notifications: server-written only (Admin SDK bypasses rules), owner
    // can read their own and mark them read/unread — never create/delete
    // from the client, and never touch anyone else's.
    match /users/{userId}/notifications/{notifId} {
      allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
      allow update: if request.auth != null && request.auth.uid == userId &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(
          ['type', 'title', 'body', 'createdAt', 'meta']
        );
      allow create, delete: if false;
    }

    // Helper to validate curriculum pre-seeding documents including the 'other' field
    function isValidCurriculum() {
      let data = request.resource.data;
      let topicValid = !data.keys().hasAny(['topic']) || (data.topic is string && data.topic.size() <= 2000);
      let passageValid = !data.keys().hasAny(['passage']) || (data.passage is string && data.passage.size() <= 10000);
      let otherValid = !data.keys().hasAny(['other']) || (data.other is string && data.other.size() <= 10000);
      return topicValid && passageValid && otherValid;
    }

    // Note: mistakes are stored at users/{uid}/data/mistakes (see the rule
    // above and services/database.ts's saveUserMistakes), not as individual
    // docs in a top-level `mistakes` collection — no code writes there. A
    // legacy rule block for that collection was removed (audit: dead rule
    // left an unused, permissive attack surface reachable directly via the
    // Firestore SDK with a valid auth token, even though nothing in the app
    // ever populated it).


    function isValidFeedback() {
      let data = request.resource.data;
      let cValid = !data.keys().hasAny(['comment']) || (data.comment is string && data.comment.size() < 2000);
      let rValid = !data.keys().hasAny(['rating']) || (data.rating is number);
      let uValid = !data.keys().hasAny(['userEmail']) || (data.userEmail is string && data.userEmail.size() < 100);
      return cValid && rValid && uValid;
    }

    // Feedback: Authenticated users can create, only admins can read.
    match /feedback/{feedbackId} {
      allow create: if request.auth != null && isValidFeedback();
      allow read: if request.auth != null && isAdmin();
    }

    // System: Only admins can write system-wide configs.
    match /system/{docId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && isAdmin();
    }
    
    // Subscriptions: Users can only read their own, backend (Admin SDK) handles writes
    match /subscriptions/{userId} {
      allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
      allow write: if isAdmin();
    }

    // Admins collection: Private.
    match /admins/{adminId} {
      allow read: if request.auth != null && request.auth.uid == adminId;
      allow write: if false; // Only manageable via Firebase Console
    }

    // Rate Limits: Only writable by the backend Admin SDK (service account).
    // Client-side access is explicitly denied. The Admin SDK bypasses these rules entirely.
    match /ratelimits/{docId} {
      allow read, write: if false;
    }

    // Quiz Quotas: Tracked server-side only. No client read/write.
    match /quiz_quotas/{docId} {
      allow read, write: if false;
    }

    // Idempotency Keys: Used for deduplication server-side only.
    match /idempotency_keys/{docId} {
      allow read, write: if false;
    }

    // School Invoices: Managed exclusively via backend Admin SDK (Vercel Serverless).
    match /school_invoices/{docId} {
      allow read, write: if false;
    }

    // Schools rules
    match /schools/{schoolId} {
      allow read: if request.auth != null && (
        isAdmin() ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.schoolId == schoolId
      );
      allow write: if request.auth != null && isAdmin();
    }

    // Teacher invites (audit §21): director dashboards read these directly via
    // the client SDK to show seat usage and pending invites, but every write
    // (create on send, claim on redemption) only ever happens server-side via
    // Admin SDK in api/create-teacher-invite.ts and api/redeem.ts (redeemInvite) —
    // role and seat-limit enforcement live there, not in these rules.
    match /invites/{inviteId} {
      allow read: if request.auth != null && (
        isAdmin() ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.schoolId == resource.data.schoolId
      );
      allow write: if false;
    }

    // Pre-added student invites (director/KT push a named invite to a
    // parent's email instead of the parent self-serving a joinCode). Same
    // shape as /invites above: director dashboards read these directly to
    // show invited/redeemed status, but every write (create on add_students,
    // resend, redeemed-status flip) only ever happens server-side via Admin
    // SDK in api/create-class.ts and api/redeem.ts.
    match /pendingStudents/{pendingStudentId} {
      allow read: if request.auth != null && (
        isAdmin() ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.schoolId == resource.data.schoolId
      );
      allow write: if false;
    }

    // Director-visible activity feed (roster approve/decline/remove/move,
    // for now) — unlike /invites and /pendingStudents above, these entries
    // are written directly from the client at the moment of the action
    // (handleApproveStudent etc. in TeacherPage.tsx already write straight
    // to Firestore, no Admin SDK endpoint exists for them), so create is
    // allowed here rather than locked to server-only. Scoped so a caller can
    // only log an action as themselves, for their own school — never spoof
    // another actor or write into a school they don't belong to.
    match /activityLog/{logId} {
      allow read: if request.auth != null && (
        isAdmin() ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.schoolId == resource.data.schoolId
      );
      allow create: if request.auth != null &&
        request.resource.data.actorUid == request.auth.uid &&
        request.resource.data.schoolId == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.schoolId;
      allow update, delete: if false;
    }

    // Classes rules
    match /classes/{classId} {
      // Scoped to the class's own teacher/director/enrolled member — no
      // current client code needs broader access (Audit: unscoped classes
      // read, lower-sensitivity data but same pattern as the fixes above).
      allow read: if request.auth != null && (
        isClassTeacher(classId) ||
        isSchoolDirectorOfClass(classId) ||
        userBelongsToClass(classId) ||
        isAdmin()
      );
      // Creation only happens server-side via api/create-class.ts (Admin SDK,
      // bypasses these rules), which counts existing classes against
      // schools/{schoolId}.seatsTotal before writing. A client-side
      // `teacherUid == request.auth.uid` create rule (the old version of this
      // rule) had no count check at all — any authenticated teacher could
      // create unlimited classes on a 1-seat plan (audit §2/§10/§18).
      allow create: if request.auth != null && isAdmin();
      // Co-teacher assignment (assignedTeacherUids) only ever happens
      // server-side via api/assign-class-teacher.ts (Admin SDK) — director-
      // authorized and school-membership-checked there. This rule only
      // covers day-to-day field updates (e.g. activeWeekNumber) by whoever
      // is already an owner or assigned teacher, not who can become one.
      //
      // Missing isSchoolDirectorOfClass here (present on the read rule
      // above) meant a director could see a class they didn't personally
      // create/get assigned to by uid, but any client-side update to it —
      // e.g. TeacherPage.tsx's week-nav control (handleUpdateWeek/
      // handleSelectWeek), carries no role gate of its own and is reachable
      // by any signed-in director browsing that class — silently
      // permission-denied. The catch swallowed it into a "saved on this
      // device only" toast with no clear signal why (audit: director's
      // active-week changes don't persist for classes they didn't create).
      allow update: if request.auth != null && (
        (
          (resource.data.teacherUid == request.auth.uid ||
            ('assignedTeacherUids' in resource.data && resource.data.assignedTeacherUids.hasAny([request.auth.uid])) ||
            isSchoolDirectorOfClass(classId)) &&
          request.resource.data.teacherUid == resource.data.teacherUid &&
          request.resource.data.assignedTeacherUids == resource.data.assignedTeacherUids
        ) ||
        isAdmin()
      );
      allow delete: if request.auth != null && (
        resource.data.teacherUid == request.auth.uid ||
        isAdmin()
      );

      // Class logs (FT/KT daily log entries). One log doc covers the WHOLE
      // class for that day — approvedExceptions is an array of every
      // enrolled student's note, not just one. Parent read access (via
      // userBelongsToClass) used to be granted on the whole doc, which
      // would leak every other kid's private note to any parent in the
      // class. No parent-facing UI reads this collection today, so nothing
      // in-app currently uses that access — removed it here so the rule
      // can't be exploited directly against Firestore in the meantime.
      // Re-add parent access only once logs are split per-student (e.g. a
      // studentNotes subcollection) so a parent can be scoped to their own
      // kid's entry, not the whole class-day doc.
      match /logs/{logId} {
        allow read: if request.auth != null && (
          isClassTeacher(classId) ||
          isSchoolDirectorOfClass(classId) ||
          isAdmin()
        );
        allow create: if request.auth != null && (
          isClassTeacher(classId) ||
          isAdmin()
        ) && request.resource.data.classId == classId;
        // The only legitimate update is a KT (or co-teacher) reviewing and
        // sending the log — writing the approved parent-facing text back
        // onto the same doc. Restricted to just those fields so a teacher
        // can't rewrite another teacher's original raw log after the fact.
        allow update: if request.auth != null && (
          isAdmin() ||
          (
            isClassTeacher(classId) &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(
              ['approvedSummary', 'approvedExceptions', 'reviewStatus', 'reviewedByUid', 'reviewedByName', 'sentAt']
            )
          )
        );
        allow delete: if request.auth != null && isAdmin();
      }

      match /studentScans/{scanId} {
        // Scoped to the class's own teacher/director or the scan's own
        // student — previously any signed-in account could read any class's
        // scan/grading data if it obtained the classId, which is a
        // semi-predictable string (Audit: unscoped studentScans read).
        allow read: if request.auth != null && (
          isClassTeacher(classId) ||
          isSchoolDirectorOfClass(classId) ||
          resource.data.studentUid == request.auth.uid ||
          isAdmin()
        );
        // A scan can only ever be written as the writer's own uid — the old
        // rule OR'd `userBelongsToClass(classId)` on its own, which let any
        // classmate create/overwrite another student's scan record, and
        // OR'd the studentUid-match on its own, which let anyone write into
        // a class they don't belong to as long as they set studentUid to
        // themselves. Both conditions are now required together.
        allow create, update: if request.auth != null && (
          (userBelongsToClass(classId) && request.resource.data.studentUid == request.auth.uid) ||
          isClassTeacher(classId) ||
          isAdmin()
        );
        allow delete: if request.auth != null && (
          isClassTeacher(classId) ||
          resource.data.studentUid == request.auth.uid ||
          isAdmin()
        );
      }
    }

    // Curriculum pre-seeding rules
    match /curriculums/{curriculumId} {
      // Scoped to the class's own teacher/director — previously any
      // signed-in account could read any school's curriculum (vocab,
      // phonics, answer keys) if it obtained the doc ID (Audit: unscoped
      // curriculums read).
      allow read: if request.auth != null && (
        // A getDoc() for a week that hasn't been saved yet targets a curriculum
        // doc that doesn't exist — resource is null, and dereferencing
        // resource.data below would error the rule (PERMISSION_DENIED instead
        // of a clean empty read). Safe to allow: there's no data to protect on
        // a document that isn't there.
        resource == null ||
        (resource.data.classId != null && (isClassTeacher(resource.data.classId) || isSchoolDirectorOfClass(resource.data.classId))) ||
        (resource.data.teacherUid != null && resource.data.teacherUid == request.auth.uid) ||
        isAdmin()
      );
      allow create: if request.auth != null && (
        isClassTeacher(request.resource.data.classId) ||
        (request.resource.data.teacherUid != null && request.resource.data.teacherUid == request.auth.uid) ||
        isAdmin()
      ) && isValidCurriculum();
      allow update: if request.auth != null && (
        (isClassTeacher(resource.data.classId) && isClassTeacher(request.resource.data.classId)) ||
        (resource.data.teacherUid == request.auth.uid && request.resource.data.teacherUid == request.auth.uid) ||
        isAdmin()
      ) && isValidCurriculum();
      allow delete: if request.auth != null && (
        isClassTeacher(resource.data.classId) ||
        (resource.data.teacherUid != null && resource.data.teacherUid == request.auth.uid) ||
        isAdmin()
      );
    }
  }
}
