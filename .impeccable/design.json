  "components": [
    {
      "name": "Platform Door Scan Button",
      "kind": "button",
      "refersTo": "button-door",
      "description": "The one door-sized primary action on scan home: orange block, ink camera circle, bilingual label pair.",
      "html": "<button class=\"ds-door\"><span class=\"ds-door-icon\"><svg width=\"28\" height=\"28\" viewBox=\"0 0 256 256\" fill=\"currentColor\"><path d=\"M208 56h-27.72l-13.63-20.44A8 8 0 0 0 160 32H96a8 8 0 0 0-6.65 3.56L75.71 56H48a24 24 0 0 0-24 24v112a24 24 0 0 0 24 24h160a24 24 0 0 0 24-24V80a24 24 0 0 0-24-24Zm8 136a8 8 0 0 1-8 8H48a8 8 0 0 1-8-8V80a8 8 0 0 1 8-8h32a8 8 0 0 0 6.66-3.56L100.28 48h55.43l13.63 20.44A8 8 0 0 0 176 72h32a8 8 0 0 1 8 8ZM128 88a44 44 0 1 0 44 44 44.05 44.05 0 0 0-44-44Zm0 72a28 28 0 1 1 28-28 28 28 0 0 1-28 28Z\"/></svg></span><span class=\"ds-door-ko\">학습지 찍기</span><span class=\"ds-door-en\">Scan a worksheet</span></button>",
      "css": ".ds-door{display:flex;flex-direction:column;align-items:flex-start;gap:0;min-height:232px;width:360px;padding:32px;border:0;border-radius:6px;background:var(--m-line,#ef7c1c);color:#16191c;text-align:left;font-family:'Pretendard Variable',Pretendard,system-ui,sans-serif;cursor:pointer;transition:transform 200ms cubic-bezier(0.16,1,0.3,1)}.ds-door:active{transform:scale(0.99)}.ds-door:focus-visible{outline:3px solid var(--m-line,#ef7c1c);outline-offset:2px}.ds-door-icon{display:inline-flex;width:56px;height:56px;border-radius:9999px;background:#16191c;color:var(--m-line,#ef7c1c);align-items:center;justify-content:center;margin-bottom:auto}.ds-door-ko{margin-top:24px;font-size:36px;font-weight:800;letter-spacing:-0.02em;line-height:1.15}.ds-door-en{margin-top:4px;font-size:16px;font-weight:500;line-height:1.3;color:rgba(22,25,28,0.75)}"
    },
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Orange action button with ink text, 48px.",
      "html": "<button class=\"ds-btn-primary\">다시 찍기</button>",
      "css": ".ds-btn-primary{min-height:48px;padding:0 16px;border:0;border-radius:6px;background:var(--m-line,#ef7c1c);color:#16191c;font:700 15px 'Pretendard Variable',Pretendard,system-ui,sans-serif;cursor:pointer;transition:transform 160ms cubic-bezier(0.23,1,0.32,1)}.ds-btn-primary:active{transform:scale(0.97)}.ds-btn-primary:focus-visible{outline:3px solid var(--m-line,#ef7c1c);outline-offset:2px}"
    },
    {
      "name": "Sign Button",
      "kind": "button",
      "refersTo": "button-sign",
      "description": "Charcoal solid secondary button: sign in, submit, unlock.",
      "html": "<button class=\"ds-btn-sign\">로그인</button>",
      "css": ".ds-btn-sign{min-height:44px;padding:0 16px;border:0;border-radius:6px;background:var(--m-sign,#1e2226);color:var(--m-on-sign,#fff);font:700 15px 'Pretendard Variable',Pretendard,system-ui,sans-serif;cursor:pointer}.ds-btn-sign:disabled{opacity:.6}.ds-btn-sign:focus-visible{outline:3px solid var(--m-line,#ef7c1c);outline-offset:2px}"
    },
    {
      "name": "Outline Button",
      "kind": "button",
      "refersTo": "button-outline",
      "description": "White panel button with a 1px inset rule ring.",
      "html": "<button class=\"ds-btn-outline\">대시보드</button>",
      "css": ".ds-btn-outline{min-height:48px;padding:0 16px;border:0;border-radius:6px;background:var(--m-surface,#fff);color:var(--m-ink,#16191c);box-shadow:inset 0 0 0 1px var(--m-rule,#d6d9d4);font:700 15px 'Pretendard Variable',Pretendard,system-ui,sans-serif;cursor:pointer}.ds-btn-outline:hover{box-shadow:inset 0 0 0 1px var(--m-ink-3,#5f666e)}.ds-btn-outline:focus-visible{outline:3px solid var(--m-line,#ef7c1c);outline-offset:2px}"
    },
    {
      "name": "Station Sign",
      "kind": "custom",
      "refersTo": "station-sign",
      "description": "Charcoal you-are-here panel: prev stop, current stop pair, next stop, orange line at the foot.",
      "html": "<section class=\"ds-sign\"><div class=\"ds-sign-side\">&larr; AI 채점<small>AI grading</small></div><div class=\"ds-sign-main\"><h1>숙제 채점</h1><p>Homework check</p></div><div class=\"ds-sign-side ds-r\">한국어 설명 &rarr;<small>Korean explanations</small></div></section>",
      "css": ".ds-sign{position:relative;display:grid;grid-template-columns:1fr auto 1fr;align-items:center;gap:24px;padding:32px 32px 40px;border-radius:6px;overflow:hidden;background:var(--m-sign,#1e2226);color:var(--m-on-sign,#fff);font-family:'Pretendard Variable',Pretendard,system-ui,sans-serif}.ds-sign::after{content:'';position:absolute;left:0;right:0;bottom:0;height:6px;background:var(--m-line,#ef7c1c)}.ds-sign-main{text-align:center}.ds-sign-main h1{margin:0;font-size:44px;font-weight:800;letter-spacing:-0.02em;line-height:1.15}.ds-sign-main p{margin:4px 0 0;font-size:18px;font-weight:500;color:var(--m-on-sign-2,#b4bac1)}.ds-sign-side{font-size:13px;font-weight:600;color:var(--m-on-sign-2,#b4bac1)}.ds-sign-side small{display:block;font-size:12px;font-weight:500;opacity:.8}.ds-r{text-align:right}"
    },
    {
      "name": "Loop Strip",
      "kind": "custom",
      "refersTo": "roundel",
      "description": "The week as stops on the orange line; the lit marker arrives at the current stop on mount (700ms arrive ease).",
      "html": "<ol class=\"ds-loop\"><li class=\"ds-cur\"><span class=\"ds-rd ds-rd-cur\">1</span><b>숙제 찍기</b><small>Scan</small></li><li><span class=\"ds-rd\">2</span><b>한국어 설명</b><small>Explain</small></li><li class=\"ds-off\"><span class=\"ds-rd ds-rd-off\">3</span><b>오답 노트</b><small>Review</small></li></ol>",
      "css": ".ds-loop{position:relative;display:grid;grid-template-columns:repeat(3,1fr);list-style:none;margin:0;padding:0;width:340px;font-family:'Pretendard Variable',Pretendard,system-ui,sans-serif}.ds-loop::before{content:'';position:absolute;top:13px;left:16.6%;right:16.6%;height:6px;border-radius:9999px;background:var(--m-rule,#d6d9d4)}.ds-loop li{position:relative;display:flex;flex-direction:column;align-items:center;text-align:center}.ds-loop b{margin-top:8px;font-size:13px;font-weight:600;color:var(--m-ink-2,#474d55)}.ds-loop small{font-size:11px;font-weight:500;color:var(--m-ink-3,#5f666e)}.ds-loop .ds-cur b{font-weight:800;color:var(--m-ink,#16191c)}.ds-loop .ds-off b{font-weight:500;color:var(--m-ink-3,#5f666e)}.ds-rd{display:inline-flex;align-items:center;justify-content:center;width:32px;height:32px;box-sizing:border-box;border:4px solid var(--m-line,#ef7c1c);border-radius:9999px;background:var(--m-surface,#fff);color:var(--m-ink,#16191c);font-size:13px;font-weight:800;font-variant-numeric:tabular-nums}.ds-rd-cur{background:var(--m-line,#ef7c1c);color:#16191c;box-shadow:0 0 0 4px var(--m-ground,#f3f4f1)}.ds-rd-off{border-color:var(--m-rule,#d6d9d4);color:var(--m-ink-3,#5f666e)}"
    },
    {
      "name": "Route Rail Stop",
      "kind": "card",
      "refersTo": "roundel-stop",
      "description": "A question as a stop on the result rail: wrong ringed red with the gentle label, right ringed green.",
      "html": "<div class=\"ds-stop\"><span class=\"ds-stop-rd\">2</span><div class=\"ds-stop-card\"><p>The book is ___ the table.</p><small>책이 탁자 ___ 있습니다.</small><em>아이와 같이 보기</em></div></div>",
      "css": ".ds-stop{position:relative;padding-left:64px;width:360px;font-family:'Pretendard Variable',Pretendard,system-ui,sans-serif}.ds-stop::before{content:'';position:absolute;left:26px;top:0;bottom:0;width:6px;border-radius:9999px;background:var(--m-line,#ef7c1c)}.ds-stop-rd{position:absolute;left:7px;top:12px;display:inline-flex;align-items:center;justify-content:center;width:44px;height:44px;box-sizing:border-box;border:5px solid var(--m-wrong,#d1242b);border-radius:9999px;background:var(--m-surface,#fff);color:var(--m-wrong,#d1242b);font-size:18px;font-weight:800}.ds-stop-card{padding:16px 20px;border-radius:6px;background:var(--m-surface,#fff);box-shadow:inset 0 0 0 1px var(--m-rule,#d6d9d4)}.ds-stop-card:hover{box-shadow:inset 0 0 0 1px var(--m-ink-3,#5f666e)}.ds-stop-card p{margin:0;font-size:16px;font-weight:600;color:var(--m-ink,#16191c)}.ds-stop-card small{display:block;margin-top:2px;font-size:14px;color:var(--m-ink-2,#474d55)}.ds-stop-card em{display:block;margin-top:8px;font-style:normal;font-size:13px;font-weight:700;color:var(--m-wrong,#d1242b)}"
    },
    {
      "name": "Text Input",
      "kind": "input",
      "refersTo": "input-text",
      "description": "Recessed field with rule ring; orange ring on focus.",
      "html": "<textarea class=\"ds-input\" placeholder=\"선생님께 남길 말\"></textarea>",
      "css": ".ds-input{width:320px;height:96px;padding:12px;border:0;border-radius:6px;resize:none;background:var(--m-sunken,#e9ebe7);color:var(--m-ink,#16191c);box-shadow:inset 0 0 0 1px var(--m-rule,#d6d9d4);font:500 15px 'Pretendard Variable',Pretendard,system-ui,sans-serif;outline:none}.ds-input::placeholder{color:var(--m-ink-3,#5f666e)}.ds-input:focus{box-shadow:inset 0 0 0 2px var(--m-line,#ef7c1c)}"
    },
    {
      "name": "Language Toggle",
      "kind": "nav",
      "refersTo": "segmented-toggle",
      "description": "Recessed segmented control; charcoal selected thumb.",
      "html": "<div class=\"ds-seg\"><button class=\"ds-on\">한</button><button>EN</button></div>",
      "css": ".ds-seg{display:inline-flex;padding:2px;border-radius:6px;background:var(--m-sunken,#e9ebe7)}.ds-seg button{min-height:36px;min-width:40px;padding:0 10px;border:0;border-radius:4px;background:transparent;color:var(--m-ink-2,#474d55);font:700 13px 'Pretendard Variable',Pretendard,system-ui,sans-serif;cursor:pointer}.ds-seg button:hover{color:var(--m-ink,#16191c)}.ds-seg .ds-on{background:var(--m-sign,#1e2226);color:var(--m-on-sign,#fff)}.ds-seg button:focus-visible{outline:3px solid var(--m-line,#ef7c1c);outline-offset:2px}"
    }
  ],
  "narrative": {
    "northStar": "The Loop Line",
    "overview": "Every parent screen is a Seoul Metro station. The family is always at a stop, the previous stop and the next one are named, and the week is one trip around a single orange line. Charcoal enamel sign panels carry the \"you are here\" moment; a pale platform-tile ground sits under everything; numbered roundels mark each step, and on the result route each question is a stop on a vertical rail.\n\nThe reader is a tired parent with her child beside her, often reading in her second language. So the system is built like transit signage: big heavy Korean (or the user's language) first, the other language small underneath, one action the size of a platform door, and colour that carries meaning rather than decoration. Orange means \"the line / go here\". Red appears only on wrong answers, green only on right ones. Light and dark follow the device; both are first-class.\n\nThe world is flat. Tone blocks, 1px tile joints, ring outlines and a 6px line do all the structural work. It refuses the in-app marketing hero: no giant slogan headline, no floating mascot card, no glow, no glass.",
    "keyCharacteristics": [
      "Charcoal station sign with the orange line along its foot as the first thing on a screen.",
      "One orange line (6px), drawn as rails, sign feet and roundel rings.",
      "Bilingual pairs: primary line large and heavy, secondary line small and medium, hidden when identical.",
      "Pretendard only, at weights 500 to 800.",
      "Platform-tile ground (48px grid, 1px joints) behind full-screen states.",
      "Flat tone blocks; soft corners (6px); circles only for roundels and the mascot badge.",
      "Light and dark themes swap the same token names."
    ],
    "rules": [
      {
        "name": "The One Line Rule",
        "body": "There is one accent hue: orange. No second brand colour, no gradients of it, no tints beyond Line Wash.",
        "section": "colors"
      },
      {
        "name": "The Signal Reservation Rule",
        "body": "Red means a wrong answer or a real error; green means a right answer or success. Neither is ever used for decoration, category, or emphasis.",
        "section": "colors"
      },
      {
        "name": "The Ink-on-Orange Rule",
        "body": "Text and icons on Line Orange are charcoal ink (#16191c) in both themes, never white.",
        "section": "colors"
      },
      {
        "name": "The Station Pair Rule",
        "body": "Bilingual text is a pair: the user's language is the primary line (large, 700 to 800), the other language sits directly under it (small, 500, Ink 3 or Sign Grey). If the two are identical the secondary is dropped. Never set them side by side at equal size.",
        "section": "typography"
      },
      {
        "name": "The One Family Rule",
        "body": "Pretendard only. No display face, no handwriting face, no monospace for flavour.",
        "section": "typography"
      },
      {
        "name": "The Door-Sized Action Rule",
        "body": "Each screen has one primary action, and it is big: the scan door fills its column. Secondary actions are outline or charcoal buttons at 44 to 48px.",
        "section": "layout"
      },
      {
        "name": "The Enamel Rule",
        "body": "Surfaces are flat tone blocks. No glass, no backdrop blur, no glow, no gradient sheen. If a resting element needs separation, use a Rule ring or a tone step, not a shadow.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do open each parent screen with a station sign that names where the family is, where they came from and what comes next.",
      "Do set every user-facing label as a Station Pair: primary language large and heavy, the other language small beneath, dropped when identical.",
      "Do keep one door-sized primary action per screen, in Line Orange with ink text.",
      "Do use roundels and the 6px orange rail for any sequence of steps or questions.",
      "Do keep red for wrong answers and errors and green for right answers and success, and phrase wrong answers gently (\"아이와 같이 보기 / Let's look together\").",
      "Do define every colour through the `--m-*` tokens so light and dark swap together; the theme follows `prefers-color-scheme` unless the user overrides it.",
      "Do keep tap targets at 44px or larger and the 3px orange focus outline intact."
    ],
    "donts": [
      "Don't build an in-app marketing hero: no giant slogan headline, no floating mascot card, no glow.",
      "Don't use glass, backdrop blur, gradients or glow shadows; surfaces are flat enamel and tile.",
      "Don't add a second accent colour or use red/green for anything but answer correctness and real status.",
      "Don't mark wrong answers with ✕ or the word \"wrong\".",
      "Don't add a fake percentage progress bar or confetti; the train arrival is the only motion moment, and grading is shown as a train in transit.",
      "Don't introduce another typeface; Pretendard carries every role.",
      "Don't set white text on Line Orange."
    ]
  }
}