{
  "name": "chekki-ai",
  "private": true,
  "version": "1.0.6",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --skipLibCheck && vite build",
    "preview": "vite preview",
    "mobile": "npm run build && mv dist/index.html dist/landing.html && cp dist/app.html dist/index.html && npx cap sync",
