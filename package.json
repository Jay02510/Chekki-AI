{
  "name": "chekki-ai",
  "private": true,
  "version": "1.3.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "test": "vitest run",
    "lint": "eslint . --ext .ts,.tsx",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "format": "prettier --write \"**/*.{ts,tsx,css,md}\"",
    "build": "tsc --skipLibCheck && vite build",
    "build:mobile": "npm run build && mv dist/index.html dist/landing.html && cp dist/app.html dist/index.html",
    "preview": "vite preview",
    "mobile": "npm run build:mobile && npx cap sync",
    "quick-mobile": "vite build --sourcemap false && mv dist/index.html dist/landing.html && cp dist/app.html dist/index.html && npx cap sync ios",
    "postinstall": "patch-package"
  },
  "dependencies": {
    "@apple/app-store-server-library": "^3.1.0",
    "@capacitor-community/apple-sign-in": "^7.1.0",
    "@capacitor-community/in-app-review": "^8.0.0",
    "@capacitor/android": "^8.1.0",
    "@capacitor/cli": "^8.1.0",
    "@capacitor/core": "^8.1.0",
    "@capacitor/filesystem": "^8.1.2",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.1.0",
    "@capacitor/share": "^8.0.1",
    "@capgo/capacitor-speech-recognition": "^8.0.10",
    "@chuseok22/capacitor-kakao-login": "^0.3.0",
    "@codetrix-studio/capacitor-google-auth": "^3.4.0-rc.4",
    "@google/genai": "1.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "@revenuecat/purchases-capacitor": "^12.2.4",
    "@sentry/node": "^10.69.0",
    "@sentry/react": "^10.69.0",
    "@tanstack/react-table": "^8.21.3",
    "@types/canvas-confetti": "^1.9.0",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.0",
    "canvas-confetti": "^1.9.4",
    "firebase": "^12.9.0",
    "firebase-admin": "^13.6.1",
    "framer-motion": "^12.42.0",
    "gsap": "^3.15.0",
    "html-to-image": "^1.11.13",
    "motion": "^12.42.0",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.2.4",
    "@types/react": "19.0.0",
    "@types/react-dom": "19.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@vercel/node": "^5.6.7",
    "@vitejs/plugin-react": "4.3.4",
    "autoprefixer": "^10.5.0",
    "eslint": "^8.57.0",
    "eslint-plugin-react": "^7.34.1",
    "eslint-plugin-react-hooks": "^4.6.0",
    "patch-package": "^8.0.1",
    "postcss": "^8.5.10",
    "prettier": "^3.2.5",
    "tailwindcss": "^4.2.4",
    "typescript": "5.6.2",
    "vite": "6.0.3",
    "vitest": "^2.1.9"
  }
}
