{
  "name": "chekki-ai",
  "private": true,
  "version": "1.1.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "lint": "eslint . --ext .ts,.tsx --fix",
    "format": "prettier --write \"**/*.{ts,tsx,css,md}\"",
    "build": "tsc --skipLibCheck && vite build",
    "build:mobile": "npm run build && mv dist/index.html dist/landing.html && cp dist/app.html dist/index.html",
    "preview": "vite preview",
    "mobile": "npm run build:mobile && npx cap sync",
    "quick-mobile": "vite build --sourcemap false && mv dist/index.html dist/landing.html && cp dist/app.html dist/index.html && npx cap sync ios"
  },
  "dependencies": {
    "@capacitor/android": "^8.1.0",
    "@capacitor/cli": "^8.1.0",
    "@capacitor/core": "^8.1.0",
    "@capacitor/filesystem": "^8.1.2",
    "@capacitor/ios": "^8.1.0",
    "@capacitor/share": "^8.0.1",
    "@capgo/capacitor-speech-recognition": "^8.0.10",
    "@google/genai": "1.3.0",
    "@revenuecat/purchases-capacitor": "^12.2.4",
    "firebase": "^12.9.0",
    "firebase-admin": "^13.6.1",
    "html-to-image": "^1.11.13",
    "react": "19.0.0",
    "react-dom": "19.0.0"
  },
  "devDependencies": {
    "@types/react": "19.0.0",
    "@types/react-dom": "19.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@vercel/node": "^5.6.7",
    "@vitejs/plugin-react": "4.3.4",
    "eslint": "^8.57.0",
    "eslint-plugin-react": "^7.34.1",
    "eslint-plugin-react-hooks": "^4.6.0",
    "prettier": "^3.2.5",
    "typescript": "5.6.2",
    "vite": "6.0.3"
  }
}
