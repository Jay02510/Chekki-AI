+
+let package = Package(
+    name: "CodetrixStudioCapacitorGoogleAuth",
+    platforms: [.iOS(.v13)],
+    products: [
+        .library(
+            name: "CodetrixStudioCapacitorGoogleAuth",
+            targets: ["CodetrixStudioCapacitorGoogleAuth"]
+        )
+    ],
+    dependencies: [
+        .package(url: "https://github.com/ionic-team/capacitor-swift-pm.git", from: "8.0.0"),
+        .package(url: "https://github.com/google/GoogleSignIn-iOS.git", from: "6.2.4")
+    ],
+    targets: [
+        .target(
+            name: "CodetrixStudioCapacitorGoogleAuth",
+            dependencies: [
+                .product(name: "Capacitor", package: "capacitor-swift-pm"),
+                .product(name: "Cordova", package: "capacitor-swift-pm"),
+                .product(name: "GoogleSignIn", package: "GoogleSignIn-iOS")
+            ],
+            path: "ios/Plugin",
+            exclude: ["Plugin.m", "Plugin.h", "Info.plist"],
+            sources: ["Plugin.swift"]
+        )
+    ]
+)
