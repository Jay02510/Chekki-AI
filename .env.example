# Chekki AI Environment Variables Template
# Copy this file to .env and fill in the values

# Google Gemini API Key
API_KEY=your_gemini_api_key_here

# Firebase Service Account (JSON string)
# Optional for local, required for Vercel backend
FIREBASE_SERVICE_ACCOUNT={"type": "service_account", ...}

# Firebase Public Config (Usually in source, but can be overridden)
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_PROJECT_ID=

# Analytics
VITE_ENABLE_ANALYTICS=true

# Admin passcode gating api/admin.ts (impersonation, deletion, upgrades) — shared/static, keep secret
ADMIN_PASSCODE=

# Apple IAP / App Store Server Notifications
APPLE_SHARED_SECRET=
APPLE_WEBHOOK_SECRET=
# 'sandbox' or unset (defaults to production) — controls which Apple environment
# api/_lib/appleWebhookVerifier.ts verifies signatures against
APPLE_IAP_ENVIRONMENT=

# RevenueCat (native subscription entitlement sync)
REVENUECAT_SECRET_KEY=

# Resend (transactional email — invoice/activation emails)
RESEND_API_KEY=

# Sentry error monitoring (api/_lib/sentry.ts, src/lib/sentry.ts)
SENTRY_DSN=
VITE_SENTRY_DSN=

# Upstash Redis (rate limiting on api/admin.ts, api/request-school-invoice.ts)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Google Cloud project id (used alongside FIREBASE_SERVICE_ACCOUNT)
GOOGLE_CLOUD_PROJECT=

# Set automatically by Vercel — do not set manually. Used to pick the Sentry
# environment tag (api/_lib/sentry.ts).
# VERCEL_ENV=
