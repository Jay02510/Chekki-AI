{
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/app",
      "destination": "/app.html"
    },
    {
      "source": "/(terms|privacy|refund|youth|support|subscribe)",
      "destination": "/app.html"
    }
  ],
  "functions": {
    "api/analyze.ts": {
      "maxDuration": 60
    },
    "api/subscription-status.ts": {
      "maxDuration": 10
    },
    "api/subscription-validate-apple.ts": {
      "maxDuration": 30
    },
    "api/subscription-validate-google.ts": {
      "maxDuration": 10
    },
    "api/subscription-validate-web.ts": {
      "maxDuration": 10
    },
    "api/subscription-webhook-apple.ts": {
      "maxDuration": 15
    }
  }
}